# Variables de entorno de la calculadora.
# Copiar a .env.local y rellenar. .env.local NO se commitea.

# ============================================================
# Webhook de n8n para captura de leads
# ============================================================
# Si esta vacia, submitLead() corre en modo mock (console.info + delay
# simulado). Cuando esta seteada, el frontend POSTea aca el lead.
# Path canonico propuesto: /webhook/calc-lead.
# Workflow n8n: ver context/infra-n8n.md.
VITE_LEAD_WEBHOOK_URL=

# ============================================================
# Meta Pixel (Facebook Pixel)
# ============================================================
# ID del pixel de Meta para tracking en la calculadora.
# Si esta vacia, no se carga el script — modo desarrollo.
# Eventos:
#   - PageView: automatico al cargar cualquier ruta.
#   - CompleteRegistration: en /gracias (post-submit del modal).
VITE_META_PIXEL_ID=

# ============================================================
# Flujo end-to-end del lead
# ============================================================
#
# 1. Usuario llega a / con UTMs en la URL.
# 2. PageView del pixel se dispara automatico.
# 3. captureUtms() guarda los UTMs en sessionStorage (primera atrib gana).
# 4. Usa la calculadora libremente.
# 5. Click en "Exportar PDF" / "Exportar CSV" -> abre modal.
# 6. Submit del form -> POST a VITE_LEAD_WEBHOOK_URL con el payload abajo.
# 7. Modal cierra -> arranca el download del PDF/CSV.
# 8. Pasados 800ms -> redirect a /gracias.
# 9. /gracias dispara CompleteRegistration en el pixel.
# 10. Click en "Calcular un nuevo presupuesto" -> /libre (sin modal).
#
# Para alumnos de la academia: link directo a /libre. Nunca ven el modal.
#
# ============================================================
# Shape del payload que POSTea al webhook
# ============================================================
# Content-Type: application/json
# {
#   "name": "Pepe Lopez",
#   "email": "pepe@correo.com",
#   "instagram": "tunombre",                  // opcional, sin @ — queda solo en el Sheet
#   "consent": true,
#   "source": "calculadora-presupuesto",      // hardcoded
#   "lead_magnet": "calculadora-presupuesto", // hardcoded
#   "calc_budget_value": 1500,                // numero, opcional
#   "submitted_at": "2026-05-01T10:30:00.000Z",
#   "utm_source": "ig",
#   "utm_medium": "paid",
#   "utm_campaign": "Q2-IG-Mid-Funnel",
#   "utm_term": "adset-mujeres-25-45",
#   "utm_content": "ad-creative-v3",
#   "gclid": "...",
#   "fbclid": "...",
#   "referrer": "https://floryjulioagencia.com/...",
#   "landing_url": "https://floryjulioagencia.com/calculadora-de-presupuestos?utm_source=...",
#   "captured_at": "2026-05-01T10:25:00.000Z"
# }
#
# ============================================================
# Convenciones de UTMs (para alinear campañas Meta/Bio)
# ============================================================
# utm_source   = ig | meta              (canal de origen)
# utm_medium   = paid | org             (de pago vs. organico)
# utm_campaign = {{campaign.name}} | LeadMagnet
# utm_term     = {{adset.name}} | Bio | Reel
# utm_content  = {{ad.name}} | calculadora
#
# Los {{placeholders}} son Dynamic Parameters de Meta — se reemplazan
# automaticamente al construir el link. Para enlaces organicos (Bio/Reel)
# usar valores literales.
#
# ============================================================
# Que entra a GHL (subcuenta F&J) y que se queda en el Sheet
# ============================================================
# A GHL (via MCP ghl-subcuenta + script en MACMINI):
#   - firstName + lastName (split del campo "name")
#   - email
#   - customFields: utm_source, utm_medium, utm_campaign, utm_term,
#     utm_content (los 5 ya existen, IDs en context/infra-ghl.md)
#   - tag: "lead-magnet:calculadora-presupuesto"
#
# Solo en el Sheet (NO entra a GHL — son datos de analisis):
#   - instagram (la red social ya esta implicita en utm_source)
#   - gclid, fbclid (para offline conversions futuras)
#   - calc_budget_value (qualifying)
#   - landing_url, referrer (analisis)
#   - submitted_at, captured_at (analisis temporal)
#
# Esto evita ensuciar la ficha del contacto en GHL con campos que solo
# se usan para analisis. Si en el futuro hace falta uno en GHL, se crea
# el custom field y se agrega al script del MACMINI.
